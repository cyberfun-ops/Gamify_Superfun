# ── Game Engine service environment ──────────────────────────────────────────
# Copy to game-engine/.env and fill in real values.

PORT=4000
NODE_ENV=production

# ── PostgreSQL (same DB as auth service) ─────────────────────────────────────
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=gamify_auth
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Inside Docker: use the service name
REDIS_URL=redis://redis:6379

# ── JWT (must match the auth service JWT_SECRET exactly) ─────────────────────
JWT_SECRET=replace_with_a_random_96_char_hex_string

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
