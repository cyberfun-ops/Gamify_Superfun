# ─────────────────────────────────────────────────────────────────────────────
# Docker environment template — Gamify Superfun
#
# USAGE:
#   cp .env.example server/.env
#   nano server/.env        # fill in real values
#
# docker-compose.yml uses:   env_file: ./server/.env
# All three API containers (api_1, api_2, api_3) share this single file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# PostgreSQL runs OUTSIDE Docker (on the host or a separate server).
#
# Option A — PostgreSQL on the SAME machine as Docker (Linux VPS):
#   DB_HOST=172.17.0.1
#   The Docker bridge gateway IP — find it with:
#     ip route show | grep docker0
#   Also ensure pg_hba.conf allows connections from 172.17.0.0/16.
#
# Option B — PostgreSQL on a SEPARATE server:
#   DB_HOST=<that-server-ip-or-hostname>
#
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=gamify_auth
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret (run this once):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_96_char_hex_string
JWT_EXPIRES_IN=7d

# ── Twilio ───────────────────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin of the React/Vite frontend.
# In production: the public URL or IP where users access the frontend.
# Express sets Access-Control-Allow-Origin to this value.
CLIENT_ORIGIN=http://<your-vps-ip-or-domain>:5173
