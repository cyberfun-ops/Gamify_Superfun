# ── Admin service environment variables ───────────────────────────────────────
# Copy this file to admin/.env and fill in real values

PORT=5000

# PostgreSQL — same database as the main app
DB_HOST=localhost
DB_PORT=5434
DB_NAME=gamify_auth
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT — can be the same secret as server/.env JWT_SECRET, or a separate one
JWT_SECRET=1f9c444012fb686519fd4ffa136bc0289a27c08813806caccd32c0bb6fd40417920bc9ee8a897392483c807f07b23dcc
JWT_EXPIRES_IN=8h

# CORS — set to your admin origin in production, or leave * for same-origin via Nginx
CLIENT_ORIGIN=*
