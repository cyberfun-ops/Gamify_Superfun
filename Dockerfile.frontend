# ── Stage 1: Build React app ─────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (layer cached unless package.json changes)
COPY gamify/package*.json ./
RUN npm ci --prefer-offline

# Copy source and build
COPY gamify/ .

# Bake env vars at build time — empty = same-origin via Nginx
ENV VITE_API_BASE_URL=""
ENV VITE_GAME_ENGINE_URL=""

RUN npm run build

# ── Stage 2: Nginx serves the built files ────────────────────────────────────
FROM nginx:1.27-alpine

# Copy compiled React app
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config (handles API proxy + static SPA serving)
COPY nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
